# Copy to burnBot_config.ini (gitignored) and adjust paths.
# On first run, the bot writes this file automatically from the activation token.
# Edit manually only if you need to override defaults.

[bot_settings]
client_id = 1
system_type = windows
bot_debug = FALSE

[api]
api_url = https://slowburnbotgamma-production.up.railway.app

[api_credentials]
# Optional: store dashboard email/password to skip manual entry at startup.
# If set, the bot can re-call /auth/jwt/login when the saved JWT expires (long runs).
# Leave blank to be prompted interactively (you must restart manually after token expiry).
email =
password =

[browser-config]
# Windows defaults (written automatically on activation for windows builds)
# chrome_path empty = system-installed Google Chrome (auto-updating; recommended).
# It may instead point at the PortableApps launcher (PortableChrome\chrome.exe); the bot
# resolves that to the real App\Chrome-bin\chrome.exe, and falls back to system Chrome if
# the account profile was last opened by a newer Chrome than the portable one.
# The browser's own User-Agent is never overridden.
chrome_version = 143
chrome_path =
chrome_user_data_dir_base = PortableChrome
add_argument =

# Linux / Docker defaults (written automatically on activation for linux builds)
# chrome_version =
# chrome_path = /usr/bin/google-chrome
# chrome_user_data_dir_base = ChromeUserData
# add_argument =

[client_ui]
# Color theme for the TUI. Options: default | tinty | terminal
# default  — built-in fixed palette (exact original look)
# tinty    — reads the active tinty scheme for exact truecolor (requires tinty in PATH)
# terminal — ANSI named colors that follow the terminal's palette automatically
tint = default

[browser-session]
headless = False
close_browser_after_session = False
close_browser_after_exit = False
bot_idle_delay = 5

# Linux / Docker defaults
# headless = True
# close_browser_after_session = False
# close_browser_after_exit = False
# bot_idle_delay = 5
